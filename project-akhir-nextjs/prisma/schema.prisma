generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String?  @unique
  createdAt DateTime @default(now())
  password  String
  role      String   @default("user")
  username  String   @unique
  sesi      Sesi[]
}

model Sesi {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pesanan {
  id            String        @id
  nama          String
  email         String
  varian        String
  jumlah        Int
  harga         Int
  subtotal      Int
  catatan       String        @default("")
  alamat        String
  jarak         Float
  ongkir        Int
  metodeBayar   String
  buktiTransfer String?
  totalBayar    Int
  tanggal       DateTime      @default(now())
  status        String        @default("Diproses")
  ratedAt       DateTime?
  rating        Int?
  ulasan        String?
  items         ItemPesanan[]
}

model ItemPesanan {
  id        Int     @id @default(autoincrement())
  pesananId String
  varian    String
  jumlah    Int
  harga     Int
  subtotal  Int
  pesanan   Pesanan @relation(fields: [pesananId], references: [id], onDelete: Cascade)
}

model Konten {
  kunci     String   @id
  nilai     String
  updatedAt DateTime @updatedAt
}

model ItemGaleri {
  id        Int    @id @default(autoincrement())
  kode      String
  judul     String
  deskripsi String
  gambar    String
  lebar     Int
  tinggi    Int
  urutan    Int    @default(0)
}

model Gambar {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}
